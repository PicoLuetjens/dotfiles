#!/usr/bin/env sh

# git gone – deletes locally checked-out Branches, whose Upstream-Branch does not exist on the remote anymore.
#
# Usage: git gone [-n|--dry-run] [-f|--force] [-h]
#   -n, --dry-run   just show, what would be deleted
#   -f, --force     delete unmerged branches too(for example after Squash-Merges)
#   -h              shop help

set -e

usage() {
	sed -n '2,7s/^# \{0,1\}//p' "$0"
}

dry=
force=
while [ $# -gt 0 ]; do
	case "$1" in
		-n|--dry-run) dry=1 ;;
		-f|--force)   force=1 ;;
		-h|--help)    usage; exit 0 ;;
		*) echo "git gone: unknown Option '$1'" >&2; usage >&2; exit 1 ;;
	esac
	shift
done

git fetch --prune

branches=$(git for-each-ref \
	--format='%(if:equals=[gone])%(upstream:track)%(then)%(refname:short)%(end)' \
	refs/heads | sed '/^$/d')

if [ -z "$branches" ]; then
	echo "No loose Branches found."
	exit 0
fi

if [ -n "$dry" ]; then
	echo "Would delete:"
	printf '  %s\n' $branches
	exit 0
fi

flag=-d
[ -n "$force" ] && flag=-D
current=$(git symbolic-ref --quiet --short HEAD || true)

for b in $branches; do
	if [ "$b" = "$current" ]; then
		echo "Ignoring '$b' (checked out at the moment)" >&2
		continue
	fi
	git branch $flag "$b" || true
done
